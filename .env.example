# Copy this file to .env and fill in your own values.
# .env is gitignored. This file is committed, so it must never contain real secrets.

PORT=3000
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# PostgreSQL connection string.
# Local development (this is what "npm run db:create" will create for you):
DATABASE_URL=postgresql://localhost:5432/job_tracker_dev
# Hosted example (Neon, Render, Supabase):
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Secret used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Auth0 (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave these blank to run the project with email + password login only.
# The server starts fine without them and prints a warning; only the "Log in
# with Auth0" button is disabled. Fill them in if you want social login.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLAIMS_NAMESPACE=https://your-app.example.com
