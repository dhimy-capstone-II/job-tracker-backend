# Copy this file to .env and fill in your own values.
# .env is gitignored. This file is committed, so it must never contain real secrets.

PORT=3000
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# PostgreSQL connection string (Neon, Render, or local).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Secret used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Auth0 application settings.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_CLAIMS_NAMESPACE=https://your-app.example.com
